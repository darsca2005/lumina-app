# Configurazione ambiente per Lumina (Cultura Quotidiana)
# Nessuna chiave a pagamento richiesta: l'app è 100% gratuita.

PORT=3456
DB_PATH=./data/lumina.db
APP_NAME=Lumina
DEFAULT_LOCALE=it

# Opzionale: se in futuro vuoi sincronizzare su Supabase Cloud invece di SQLite locale
SUPABASE_URL=
SUPABASE_ANON_KEY=
